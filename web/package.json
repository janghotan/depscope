{
  "name": "depscope-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "predev": "pnpm run sync:contract",
    "dev": "next dev",
    "prebuild": "pnpm run sync:contract",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run sync:contract",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "sync:contract": "node scripts/sync-contract.mjs",
    "generate:types": "node scripts/generate-types.mjs",
    "check:contract": "node scripts/check-contract.mjs"
  },
  "dependencies": {
    "@fontsource-variable/overpass": "5.3.0",
    "@fontsource-variable/overpass-mono": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
