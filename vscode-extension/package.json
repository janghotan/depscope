{
  "name": "depscope-vscode",
  "displayName": "DepScope",
  "description": "Dependency security inspection and vulnerability intelligence for VS Code",
  "version": "0.1.0",
  "publisher": "depscope",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:package.json",
    "workspaceContains:requirements.txt"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "depscope",
          "title": "DepScope",
          "icon": "media/depscope.svg"
        }
      ]
    },
    "views": {
      "depscope": [
        {
          "id": "depscope.views.scanTree",
          "name": "DepScope"
        }
      ]
    },
    "commands": [
      {
        "command": "depscope.openScanWizard",
        "title": "DepScope: Scan Workspace...",
        "category": "DepScope",
        "icon": "$(play)"
      },
      {
        "command": "depscope.scanWorkspace",
        "title": "DepScope: Scan Workspace",
        "category": "DepScope",
        "icon": "$(refresh)"
      },
      {
        "command": "depscope.showReport",
        "title": "DepScope: Show Finding Report",
        "category": "DepScope"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "depscope.openScanWizard",
          "when": "view == depscope.views.scanTree",
          "group": "navigation@1"
        },
        {
          "command": "depscope.scanWorkspace",
          "when": "view == depscope.views.scanTree",
          "group": "navigation@2"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "depscope.views.scanTree",
        "contents": "No scan results available for this workspace.\n[Scan Workspace](command:depscope.openScanWizard)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "generate-types": "node scripts/generate-types.mjs"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "glob": "^14.0.3",
    "mocha": "^12.0.3",
    "typescript": "^5.4.0"
  }
}
