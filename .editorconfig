# .editorconfig：跨编辑器统一缩进、换行符与字符编码。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go 源码使用制表符缩进，由 gofmt 强制。
[*.go]
indent_style = tab

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
